{
  "info": {
    "name": "College Event Booking API",
    "description": "Run the whole collection with the Collection Runner (server must be running). Needs the database from 'npm run setup'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "studentEmail",
      "value": ""
    },
    {
      "key": "studentToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "eventId",
      "value": ""
    },
    {
      "key": "newEventId",
      "value": ""
    }
