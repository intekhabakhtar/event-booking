# Copy this file to .env and edit
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/event_booking
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=2h
# Connection pool size (max simultaneous DB connections)
DB_POOL_MAX=20
# GUARD=on  -> lock + availability check + CHECK constraint (normal)
# GUARD=off -> NO lock, NO availability check; only the CHECK constraint protects data (for the demo)
GUARD=on
