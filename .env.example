# Copy this file to .env and edit
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/event_booking
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=2h
# Connection pool size (max simultaneous DB connections)
DB_POOL_MAX=20
# GUARD=on  -> lock + availability check + CHECK constraint (normal)
# GUARD=off -> NO lock, NO availability check; only the CHECK constraint protects data (for the demo)
GUARD=on

# Password for admin@college.edu created by `npm run setup` (CHANGE IT before deploying)
ADMIN_PASSWORD=admin123
# Set NODE_ENV=production when deployed: the server then refuses to start without a real JWT_SECRET
# NODE_ENV=production
# Max register/login/forgot-password attempts per IP per 15 minutes (brute-force protection)
AUTH_RATE_LIMIT=100
# LOG_QUERIES=on prints every SQL statement with its run time in ms (useful for the indexes / EXPLAIN demo)
LOG_QUERIES=off
